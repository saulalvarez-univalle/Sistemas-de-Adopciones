# Configuración de Firebase.
# Copiar este archivo como .env solo si se quiere apuntar a otro proyecto
# de Firebase. Si no existe .env, la aplicación usa los valores por defecto
# definidos en src/services/firebase.js y funciona igual.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# Subida de imágenes a Cloudinary.
#
# Los dos valores son públicos: el nombre de la nube aparece en la URL de
# cada imagen y el preset solo autoriza lo que el dueño de la cuenta le
# permitió. No son secretos. Si se dejan vacíos, la aplicación funciona
# igual y el formulario ofrece solo el campo de enlace.
#
# Cómo obtenerlos:
#   1. Crear una cuenta gratuita en cloudinary.com (no pide tarjeta).
#   2. El Cloud name está en el panel principal.
#   3. Settings -> Upload -> Upload presets -> Add upload preset.
#      Poner "Signing Mode" en Unsigned y guardar. El nombre que quede
#      es el que va en la segunda variable.

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
