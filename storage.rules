rules_version = '2';

// =========================================================
// RED HUELLA - Reglas de seguridad de Firebase Storage
//
// NO DESPLEGADO. El proyecto esta en el plan Spark de Firebase, que no
// habilita Cloud Storage sin pasar a facturacion. Por eso la seccion
// "storage" no figura en firebase.json: incluirla hace fallar el
// despliegue completo.
//
// Mientras tanto, las fotografias de las mascotas se registran por
// enlace a una imagen ya publicada. Estas reglas quedan escritas y
// listas para el dia que el proyecto pase al plan Blaze: bastara con
// volver a declarar la seccion "storage" en firebase.json.
// =========================================================

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    function esImagenValida() {
      return request.resource.contentType.matches("image/(jpeg|jpg|png)") &&
        request.resource.size < 3 * 1024 * 1024;
    }

    function albergueDelUsuario(albergueId) {
      return autenticado() &&
        firestore.get(
          /databases/(default)/documents/albergues/$(albergueId)
        ).data.userId == request.auth.uid;
    }

    // Fotografías de mascotas (HU-08).
    match /mascotas/{albergueId}/{archivo} {

      allow read: if true;

      allow write: if albergueDelUsuario(albergueId) &&
        esImagenValida();
    }

    // Fotografía de perfil del usuario.
    match /perfiles/{userId}/{archivo} {

      allow read: if true;

      allow write: if autenticado() &&
        request.auth.uid == userId &&
        esImagenValida();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
